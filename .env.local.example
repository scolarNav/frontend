# --- API ---
NEXT_PUBLIC_API_URL=https://juniorforge.onrender.com/scholars/api

# --- Site / SEO ---
# Public URL of THIS deployment. Production MUST be https://www.scolarnav.com (www, https, no trailing slash).
# Staging/preview deployments must set their own URL so robots.txt blocks them.
NEXT_PUBLIC_SITE_URL=https://www.scolarnav.com
# Set to "true" to force noindex + "Disallow: /" on any deployment (e.g. staging that shares the prod URL).
NEXT_PUBLIC_NOINDEX=
# Search engine ownership verification (meta tag method). Paste ONLY the content value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Optional social profiles for Organization schema / Twitter card. Comma-separated full URLs; handle like @scolarnav.
NEXT_PUBLIC_SOCIAL_PROFILES=
NEXT_PUBLIC_TWITTER_HANDLE=

# --- Auth ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Stripe publishable price IDs (from dashboard.stripe.com → Products)
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL=price_...

# Paystack plan codes (from dashboard.paystack.com → Plans)
NEXT_PUBLIC_PAYSTACK_PLAN_MONTHLY=PLN_...
NEXT_PUBLIC_PAYSTACK_PLAN_ANNUAL=PLN_...

# On-demand cache revalidation — must match REVALIDATION_SECRET in the backend .env
REVALIDATION_SECRET=replace-with-a-long-random-secret

# Startup-grants section (/grants) is hidden by default. Set to "true" to show it again.
NEXT_PUBLIC_SHOW_GRANTS=
